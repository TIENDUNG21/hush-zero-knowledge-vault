#!/usr/bin/env php
<?php

declare(strict_types=1);

use Hush\Admin\AdminApplication;
use Hush\Config\Config;

require dirname(__DIR__) . '/vendor/autoload.php';

$arguments = array_values(array_slice($argv, 1));

exit((new AdminApplication(Config::fromEnvironment(getenv(), dirname(__DIR__))))->run($arguments, STDOUT, STDERR));
